ERPNEXT_URL=https://erp.bnbcloudservices.com
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret
ERPNEXT_COMPANY=Sindh Bakery
# Comma-separated list of allowed browser origins (the Next.js dev/prod URL)
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010
CACHE_TTL_SECONDS=120
# Cache for the live comparison board (polled every few seconds); keep short so refreshes are fresh
LIVE_CACHE_TTL_SECONDS=15

# Days whose bills are opening / bulk stock entries, not retail sales. Totals keep them; averages,
# best/lowest day and weekday baselines leave them out. Comma-separated YYYY-MM-DD.
EXCLUDE_DATES_FROM_STATS=2026-04-16,2026-05-03,2026-05-05,2026-05-11,2026-06-02
# Extra closure dates (Eid etc.) to leave out of the live board's 4-week same-weekday baseline
LIVE_EXCLUDE_DATES=
# Monthly net-sales targets, "YYYY-MM:amount" pairs plus an optional default. The owner can also
# type a target on the dashboard tile (stored in that browser), which overrides these.
MONTHLY_TARGETS=

# Voice assistant (mic button on the dashboard). Leave the key empty to hide voice.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional overrides
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
